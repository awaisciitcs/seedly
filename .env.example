# Supabase configuration for Seedly
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Required for secure checkout, private receipts, restock persistence and reference allocation.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stable private signing key for checkout quotes and retry capabilities. Never expose it to clients.
CHECKOUT_SIGNING_SECRET=YOUR_RANDOM_SERVER_ONLY_SIGNING_SECRET

# Enable only after applying and verifying the sequential reference migration.
ORDER_REFERENCE_MODE=sequential

# Order email delivery. Configure a verified sending domain and recurring worker.
EMAIL_PROVIDER=resend
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_KEY
EMAIL_FROM="Seedly <seedly@softbytes.co.uk>"
EMAIL_REPLY_TO=seedly@softbytes.co.uk

EMAIL_SITE_URL=https://seedly.softbytes.co.uk
EMAIL_CRON_SECRET=YOUR_RANDOM_SERVER_ONLY_WORKER_SECRET
EMAIL_WORKER_ORIGIN=http://127.0.0.1:3000
